# 서버의 /opt/job-tracker/.env 로 복사해 채운다. 실제 값은 git에 올리지 않는다.
APP_IMAGE=<계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com/job-tracker:latest
API_DOMAIN=

PGDATABASE=jobtracker
PGUSER=jobtracker
PGPASSWORD=

JWT_SECRET=
MAIL_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

S3_BUCKET=
AWS_REGION=ap-northeast-2
